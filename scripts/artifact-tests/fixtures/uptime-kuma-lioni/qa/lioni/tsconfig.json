{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "../../lioni.config.ts",
    "*.ts",
    "checks/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "quantities/**/*.ts"
  ]
}
