{
  "build": {
    "args": {
      "NODE_VERSION": "24.21.0"
    },
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "mounts": [
    {
      "source": "${devcontainerId}-pnpm-store",
      "target": "/pnpm/store",
      "type": "volume"
    }
  ],
  "name": "l10n"
}
