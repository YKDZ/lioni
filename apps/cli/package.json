{
  "name": "lioni",
  "version": "0.1.0",
  "private": false,
  "description": "多语言项目资源检查与维护工具，提供命令行与 TypeScript SDK。",
  "homepage": "https://github.com/YKDZ/lioni",
  "bugs": {
    "url": "https://github.com/YKDZ/lioni/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YKDZ/lioni",
    "directory": "apps/cli"
  },
  "bin": {
    "lioni": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "postbuild": "node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "node --conditions=source --test --test-reporter=spec --test-reporter=./scripts/node-test-count-reporter.ts --test-reporter-destination=stdout --test-reporter-destination=stderr 'test/e2e/standard-schema.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "test:e2e": "node --conditions=source --test --test-timeout=180000 --test-reporter=spec --test-reporter=./scripts/node-test-count-reporter.ts --test-reporter-destination=stdout --test-reporter-destination=stderr 'test/e2e/run-journeys.test.ts'"
  },
  "dependencies": {
    "@intlify/message-compiler": "11.2.8",
    "@standard-schema/spec": "1.1.0",
    "@valibot/to-json-schema": "catalog:",
    "@ykdz/cli-contract": "catalog:",
    "valibot": "catalog:",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@lioni/checks": "workspace:*",
    "@lioni/core": "workspace:*",
    "@lioni/memo": "workspace:*",
    "@lioni/terminology": "workspace:*",
    "@lioni/text-analysis": "workspace:*",
    "@lioni/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^24.21.0"
  }
}
