{
  "literals": {
    "halopsa_id_usage_hint": ["monitor_id", "heartbeat_id"],
    "halopsa_setup_step5": ["monitor_id"],
    "wayToGetTelegramChatID": ["chat_id"],
    "wayToGetBaleChatID": ["chat_id"],
    "smtpHelpText": ["SMTPS", "SMTP", "TLS", "STARTTLS"],
    "trustProxyDescription": ["X-Forwarded-*"]
  },
  "scopes": [
    {
      "scope": "notifications.email",
      "keys": ["From Email", "To Email", "emailCustomBody"],
      "keyPattern": "^(?:brevo|resend|smtp)",
      "flags": "iu"
    },
    {
      "scope": "notifications.chat",
      "keyPattern": "^(?:onebot|milky|waha|openwa)",
      "flags": "iu"
    },
    {
      "scope": "notifications.sms",
      "keyPattern": "^(?:smseagle|serwersms|threema|Recipient Type|Group ID)",
      "flags": "iu"
    },
    {
      "scope": "settings.api-keys",
      "keyPattern": "^apiKey-",
      "flags": "u"
    },
    {
      "scope": "maintenance",
      "keyPattern": "^(?:maintenance|statusPageMaintenance)",
      "flags": "iu"
    },
    {
      "scope": "message-position",
      "keys": ["End"]
    },
    {
      "scope": "notifications.gorush",
      "keys": ["Topic"]
    },
    {
      "scope": "messaging.topic",
      "keys": ["topic"]
    },
    {
      "scope": "monitors.push-url",
      "keys": ["Push URL", "PushUrl", "FlashDuty Push URL"]
    },
    {
      "scope": "monitors.list",
      "keys": ["Active", "Inactive", "filterActive", "filterInactive", "Group"]
    },
    {
      "scope": "notifications.instructions",
      "keyPattern": "^(?:GrafanaOncall|wayToGet.*Token|support.*ChatID|wayToGet.*ChatID)",
      "flags": "u"
    }
  ],
  "usageScopes": [
    {
      "scope": "notifications.general",
      "filePattern": "/notifications/"
    },
    {
      "scope": "status-pages",
      "filePattern": "StatusPage|status-page"
    },
    {
      "scope": "monitors",
      "filePattern": "Monitor"
    },
    {
      "scope": "settings",
      "filePattern": "settings/"
    }
  ]
}
