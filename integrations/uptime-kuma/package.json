{
  "name": "lioni-uptime-kuma-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": {
      "source": "./src/config.ts",
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./overlay": {
      "source": "./overlay.ts",
      "types": "./overlay.ts",
      "default": "./overlay.ts"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different package.json tsconfig.json turbo.json overlay.ts overlay/*.ts src test",
    "format:write": "oxfmt --write package.json tsconfig.json turbo.json overlay.ts overlay/*.ts src test",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --ignore-pattern node_modules . --fix",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@lioni/core": "workspace:*",
    "@lioni/terminology": "workspace:*",
    "@lioni/vue-i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1"
}
