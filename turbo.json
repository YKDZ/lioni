{
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["app", "library"]
        }
      },
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      }
    }
  },
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"],
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#verify:independent-consumer": {
      "cache": false,
      "outputs": [],
      "tags": ["quality:heavy"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
