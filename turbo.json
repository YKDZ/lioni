{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "tags": ["quality:light"]
    },
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "dependsOn": [
        "@lioni/checks#build",
        "@lioni/core#build",
        "@lioni/memo#build",
        "@lioni/terminology#build",
        "@lioni/text-analysis#build"
      ],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "dependsOn": [
        "@lioni/checks#build",
        "@lioni/core#build",
        "@lioni/memo#build",
        "@lioni/terminology#build",
        "@lioni/text-analysis#build"
      ],
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "dependsOn": [
        "@lioni/checks#build",
        "@lioni/core#build",
        "@lioni/memo#build",
        "@lioni/terminology#build",
        "@lioni/text-analysis#build"
      ],
      "tags": ["quality:light"]
    },
    "//#publication:pack": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#publication:publish": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#verify:artifacts": {
      "cache": false,
      "dependsOn": ["lioni#test:e2e", "lioni#build"],
      "outputs": [],
      "tags": ["quality:heavy"],
      "passThroughEnv": ["LIONI_KEEP_ARTIFACT_TESTS"]
    },
    "//#terminology:evaluation:performance": {
      "cache": false,
      "outputs": [],
      "tags": ["work:on-demand"]
    },
    "//#terminology:evaluation:quality": {
      "cache": false,
      "outputs": [],
      "tags": ["work:on-demand"]
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["app", "library"]
        }
      },
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      }
    }
  },
  "globalDependencies": [
    "packages/tooling-config/oxfmt.config.ts",
    "packages/tooling-config/oxlint.config.ts"
  ]
}
