{
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#publication:pack": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#publication:publish": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#verify:independent-consumer": {
      "cache": false,
      "dependsOn": [
        "@lioni/cli#test:e2e",
        "@lioni/cli#build",
        "@lioni/checks#build",
        "@lioni/core#build"
      ],
      "outputs": [],
      "tags": ["quality:heavy"],
      "passThroughEnv": ["LIONI_KEEP_CONSUMER"]
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["app", "library"]
        }
      },
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      }
    }
  },
  "globalDependencies": [
    "packages/tooling-config/oxfmt.config.ts",
    "packages/tooling-config/oxlint.config.ts"
  ]
}
