{
  "name": "@lioni/vue-i18n",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@intlify/message-compiler": "11.2.8",
    "@lioni/checks": "workspace:*",
    "@lioni/core": "workspace:*",
    "@lioni/memo": "workspace:*",
    "@lioni/terminology": "workspace:*",
    "@lioni/text-analysis": "workspace:*",
    "@vue/compiler-dom": "3.4.38",
    "@vue/compiler-sfc": "3.4.38"
  },
  "devDependencies": {
    "@lioni/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "npm:typescript@^7.0.2",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  }
}
